---
import { getCollection } from 'astro:content';

interface Props {
  category: string;
  type: string;
  hideCategory?: boolean;
  hideType?: boolean;
}

const { category, type, hideCategory = true, hideType = false } = Astro.props;

const allDeadlines = await getCollection('deadlines');
const deadline = allDeadlines.find(
  (d) => d.data.category.toLowerCase() === category.toLowerCase() && 
         d.data.type.toLowerCase() === type.toLowerCase()
)?.data;

const formatDate = (dateStr: string) => {
  const formatted = new Date(dateStr).toLocaleString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
    timeZone: 'Etc/GMT+12' // AoE (UTC-12)
  });
  return `${formatted} AoE`;
};
---

{deadline ? (
  <span 
    class="inline-deadline deadline-tracker" 
    data-original={deadline.originalDate}
    data-extended={deadline.extendedDate || ""}
  >
    { hideType ? null : hideCategory ? (
        <><strong>{deadline.type}:</strong>{" "}</>
    ) : (
        <><strong>{deadline.category} ({deadline.type}):</strong>{" "}</>
    )}
    <span class="date-display">
      {deadline.extendedDate ? (
        <>
          <span class="crossed-out">{formatDate(deadline.originalDate)}</span>
          <span class="extension">Extended: {formatDate(deadline.extendedDate)}</span>
        </>
      ) : (
        <span class="normal-date">{formatDate(deadline.originalDate)}</span>
      )}
    </span>
    <span class="local-date"></span>
  </span>
) : (
  <span class="error">Deadline not found</span>
)}

<script>
  function updateCountdowns() {
    const trackers = document.querySelectorAll('.deadline-tracker');
    const now = new Date().getTime();

    trackers.forEach((el) => {
      const tracker = el as HTMLElement;
      const original = tracker.dataset.original;
      const extended = tracker.dataset.extended;
      
      const targetString = extended || original;
      if (!targetString) return;

      // Automatically parses the ISO -12:00 target string correctly
      const targetTime = new Date(targetString).getTime();

      const localEl = tracker.querySelector('.local-date');
      if (localEl) {
        localEl.textContent = ` (${new Date(targetTime).toLocaleString('en-US', {
          month: 'short',
          day: 'numeric',
          year: 'numeric',
          hour: '2-digit',
          minute: '2-digit',
          hour12: false,
          timeZoneName: 'short'
        })})`;
      }

      const diffMs = targetTime - now;

      if (diffMs <= 0) {
        tracker.classList.add('is-expired');
        tracker.title = 'Expired';
      } else {
        tracker.classList.remove('is-expired');
        
        // Calculate intervals
        const days = Math.floor(diffMs / (1000 * 60 * 60 * 24));
        const hours = Math.floor((diffMs % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((diffMs % (1000 * 60 * 60)) / (1000 * 60));

        let displayString = '';
        if (days > 0) displayString += `${days}d `;
        displayString += `${hours}h ${minutes}m left`;

        tracker.title = displayString;
      }
    });
  }

  // Run on load and update every 30 seconds
  updateCountdowns();
  setInterval(updateCountdowns, 30000);
</script>

<style>
  .inline-deadline {
    font-family: system-ui, sans-serif;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }
  .crossed-out {
    text-decoration: line-through;
    color: #888;
    margin-right: 0.35rem;
  }
  .extension {
    color: #e53e3e;
    font-weight: 600;
  }
  .is-expired .date-display {
    opacity: 0.5;
  }
  .local-date {
    font-size: 0.85em;
    color: #666;
  }
</style>
