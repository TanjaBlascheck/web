---
import Disclaimer from './disclaimer.mdx';
import { Image } from 'astro:assets';
import imageSilhouette from '../assets/logos/silhouette_stuttgart_long_blue.svg';

interface Props {
  colorLightBlue: string;
  colorMediumBlue: string;
  colorAnthracite: string;
  colorOrange: string;
  sourceFile?: string;
}
const { colorLightBlue, colorMediumBlue, colorAnthracite, colorOrange, sourceFile } = Astro.props;
---

<!-- CSS -------------------------------------------------------- -->
<!-- Make it global to also have it applied to included components -->
<style is:global define:vars={{ colorLightBlue, colorMediumBlue, colorAnthracite, colorOrange }}> 

    footer {
        display:                block;
        text-align:             center;
        position:               relative;
        margin:                 0;
        padding:                0;
        background-color:       var(--colorMediumBlue);
        width:                  100%;
    }

    .disclaimer {
        font-size:              0.8rem;
        color:                  white;
        padding-bottom:         1rem;
        width:                  100%;
    }

    .disclaimer a {
        color:                  white;
    }

    .banner-image {
        display:                flex;
        width:                  100%;
        max-width:              2560px;
        flex-shrink:            0;
        height:                 auto;
        margin:                 0;
        padding:                0;
        margin-bottom:          -3px;
        background-color:       white;
    }

    .disclaimer-top {
        display: flex;
        width: 100%;
        justify-content: center;
        align-items: stretch;
    }

    .filling-element {
        flex: 1;
        background-color:       white;
    }

/***** Additional options for Responsive Web Design *****/

</style>


<!-- HTML ------------------------------------------------------- -->
<footer>
    <div class="disclaimer">
        <div class="disclaimer-top">
            <div class="filling-element"></div>
            <Image
                src={imageSilhouette}
                alt="Silhouette of Stuttgart"
                class="banner-image"
            />
            <div class="filling-element"></div>
        </div>
        <div class="disclaimer-bottom">
            <Disclaimer sourceFile={sourceFile} />
        </div>
    </div>
</footer>
